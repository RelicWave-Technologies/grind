# --- Database (Neon Postgres) ---
# Pooled URL (used at runtime by API). Note: pgbouncer=true disables prepared statements.
DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/grind?sslmode=require&pgbouncer=true&connection_limit=1"
# Direct URL (used by `prisma migrate`). pgbouncer can't handle advisory locks / DDL.
DIRECT_URL="postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/grind?sslmode=require"

# --- API ---
API_PORT=4000
NODE_ENV=development
# Generate with: openssl rand -base64 32
JWT_SECRET="REPLACE_WITH_OPENSSL_RAND_BASE64_32"
JWT_ACCESS_TTL_SECONDS=900       # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000  # 30 days

# --- Agent ---
# Where the Electron agent looks for the API. Override per-machine via env var or .env.local.
AGENT_API_URL="http://localhost:4000"

# --- Cloudinary (screenshot storage) ---
# When all three are set, the API signs direct uploads from the agent and the
# agent pushes screenshots to Cloudinary. Leave unset to keep shots local-only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder screenshots land in (optional; defaults to grind/screenshots).
CLOUDINARY_FOLDER="grind/screenshots"

# --- Google Drive screenshot storage ---
# Preferred VPS storage path. Create a service account, share a dedicated Drive
# folder with that service account email, and paste the folder id below.
# Use PRIVATE_KEY_BASE64 to avoid newline escaping issues.
GOOGLE_DRIVE_CLIENT_EMAIL=""
GOOGLE_DRIVE_PRIVATE_KEY=""
GOOGLE_DRIVE_PRIVATE_KEY_BASE64=""
GOOGLE_DRIVE_FOLDER_ID=""
GOOGLE_DRIVE_SHARED_DRIVE_ID=""

# Public origin of the deployed dashboard (used for CORS + cross-site cookies).
# One URL, or a comma-separated list (the first is used for redirects).
# Empty = unset: CORS reflects any origin (dev only).
# e.g. https://timo.emiactech.com
DASHBOARD_URL=""
# Public origin used when the API mints absolute URLs back to itself.
# For VPS single-domain deploy: https://timo.emiactech.com
PUBLIC_APP_URL=""

# --- Lark / Feishu integration (optional) ---
# Leave unset to run with Lark disabled (the API degrades gracefully).
# Create a custom internal app in the Lark Developer Console, enable Bot +
# Interactive Card, and grant the scopes listed in apps/api/src/lark/config.ts.
LARK_APP_ID=""
LARK_APP_SECRET=""
# 32-byte key that encrypts OAuth refresh tokens at rest. REQUIRED if the two
# above are set. Generate with: openssl rand -base64 32
LARK_TOKEN_KEY=""
# OAuth v2 hosts (international tenant defaults shown; use feishu.cn for China).
LARK_OAUTH_HOST="https://open.larksuite.com"
LARK_ACCOUNTS_HOST="https://accounts.larksuite.com"
# Where Lark redirects after the user authorizes. Register BOTH URLs in the
# Lark Developer Console. Login and task-connect are intentionally separate.
LARK_LOGIN_REDIRECT_URI="http://localhost:4000/v1/auth/lark/callback"
LARK_CONNECT_REDIRECT_URI="http://localhost:4000/v1/lark/oauth/callback"
# Legacy single-redirect fallback. Do not use for new environments.
LARK_OAUTH_REDIRECT_URI=""

# --- Lark login provisioning ---
# Comma-separated emails created as ACTIVE ADMIN on first Lark login (bootstrap).
# Everyone else is provisioned PENDING until an admin activates them.
LARK_BOOTSTRAP_ADMIN_EMAILS="abhishek@emiactech.com"
# --- Developer tools ---
# Comma-separated emails allowed to use the hidden developer tools (remote
# agent resync at /dev/resync). Empty = off; the routes answer 404.
DEVELOPER_EMAILS=""
# Fixed id for the single workspace (idempotent upsert; avoids dup workspaces).
WORKSPACE_ID="ws_default"
# DEV ONLY: keep the legacy email/password /v1/auth/login mounted for local dev
# + tests. Ignored (hard-off) in production. Leave 'false' / unset otherwise.
ALLOW_PASSWORD_LOGIN="false"

# --- Lark approvals (leave + WFH mirroring) ---
# approval_code of the Lark "Leave" and "Work From Home Request" approvals.
# Present = decided in Lark and mirrored into Timo; absent = feature off.
# Production sets these in infra/vps/docker-compose.prod.yml.
# LARK_LEAVE_APPROVAL_CODE=
# LARK_WFH_APPROVAL_CODE=

# --- Timo tester-ops bot (Lark group helper) ---
# NOTE: these seed the TesterOpsConfig / TesterOpsAiPolicy rows the first time
# they are created. After that the DB rows are the live settings (chat, ping
# times, passive mode, AI provider/model); edit the rows, not these values.
# Turn the bot on for this process (also gates its schedulers).
TIMO_TESTER_BOT_ENABLED="false"
# Lark chat_id of the tester group the bot posts in (oc_...).
# TIMO_TESTER_GROUP_CHAT_ID=
# Daily ping times, HH:MM in the workspace timezone, comma-separated.
TIMO_TESTER_PING_TIMES="11:00,17:00"
# How often group history is polled, ms (3000-300000).
TIMO_TESTER_HISTORY_POLL_INTERVAL_MS=5000
# Detect issues from ordinary group messages, not only @Timo mentions.
TIMO_PASSIVE_ISSUE_DETECTION_ENABLED="false"
# Lark image_keys for card artwork (optional; cards render without them).
# TIMO_CARD_MASCOT_IMAGE_KEY=
# TIMO_CARD_STREAMING_IMAGE_KEY=

# --- Timo AI (tester-ops brain) ---
# Master switch for model calls; off = rule-based replies only.
TIMO_AI_ENABLED="false"
# openrouter | deepseek. The matching key below is required when enabled.
TIMO_AI_PROVIDER="openrouter"
# Model id for the provider (optional; the DB policy row can set it instead).
# TIMO_AI_MODEL=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# Per-call timeout (1000-120000 ms) and prompt size cap (1000-50000 chars).
TIMO_AI_TIMEOUT_MS=30000
TIMO_AI_MAX_INPUT_CHARS=12000

# --- Desktop Today ledger rollout ---
# OFF | SHADOW | VISIBLE. Optional canary user ids (comma-separated) restrict
# SHADOW/VISIBLE to those people.
TIMO_TODAY_LEDGER_MODE="OFF"
# TIMO_TODAY_LEDGER_CANARY_USER_IDS=

# --- Timer lifecycle rollout ---
# Keep false for the schema/API deploy. Enable only after protocol-v2 desktop
# checkpoints are visible and the legacy stale-entry audit has been reviewed.
TIMO_TIMER_LEASE_RECONCILER_ENABLED="false"
