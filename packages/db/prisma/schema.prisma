/// Content-free anti-cheat detection. One row per (user, window-start, type)
/// raised by the risk engine when activity samples are batch-uploaded.
/// `evidence` carries the engine's signal breakdown (rates, CVs, etc.) for
/// the dashboard's review queue — never key/text content.
enum FlagType {
  IMPOSSIBLE_RATE
  METRONOMIC
  LINEAR_MOUSE
  SINGLE_CHANNEL
  JIGGLER
}

enum FlagStatus {
  OPEN
  RESOLVED
}

enum FlagResolution {
  DISMISSED // reviewer says the activity was legitimate
  CONFIRMED // reviewer agrees it looks like cheating
  TIME_INVALIDATED // reviewer dropped the matching time (future hook)
}

model ActivityFlag {
  id               String            @id @default(cuid())
  userId           String
  user             User              @relation("FlagSubject", fields: [userId], references: [id])
  type             FlagType
  windowStart      DateTime // start of the minute-window the engine assessed
  windowEnd        DateTime
  riskScore        Int // 0–100 contribution from RISK_WEIGHTS[type]
  /// JSON keyed by signal name (eg ikiCv, pathStraightness, keysPerMin).
  /// Numbers only; the dashboard renders these as small read-only chips.
  evidence         Json
  status           FlagStatus        @default(OPEN)
  resolution       FlagResolution?
  resolvedById     String?
  resolvedBy       User?             @relation("FlagResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt       DateTime?
  resolvedNote     String?
  createdAt        DateTime          @default(now())
  timeInvalidation TimeInvalidation?

  /// Dedupe key: re-uploading the same window should not double-flag.
  @@unique([userId, windowStart, type])
  @@index([userId, status])
  @@index([status, createdAt])
}

/// Immutable audit record that removes a reviewed anti-cheat window from
/// counted totals without deleting raw TimeEntry/Screenshot/ActivitySample rows.
model TimeInvalidation {
  id              String       @id @default(cuid())
  workspaceId     String
  workspace       Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  flagId          String       @unique
  flag            ActivityFlag @relation(fields: [flagId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation("TimeInvalidationSubject", fields: [userId], references: [id], onDelete: Cascade)
  windowStart     DateTime
  windowEnd       DateTime
  invalidatedById String?
  invalidatedBy   User?        @relation("TimeInvalidationActor", fields: [invalidatedById], references: [id], onDelete: SetNull)
  reason          String
  createdAt       DateTime     @default(now())

  @@index([workspaceId, windowStart])
  @@index([userId, windowStart])
}

/// Immutable audit trail for screenshot/idle timing changes. This exists so
/// unusually aggressive monitoring settings are explainable after the fact.
model MonitoringSettingsAudit {
  id                            String                      @id @default(cuid())
  workspaceId                   String
  workspace                     Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorId                       String?
  actor                         User?                       @relation("MonitoringSettingsAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  targetUserId                  String?
  targetUser                    User?                       @relation("MonitoringSettingsAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  scope                         MonitoringSettingsScope
  previousScreenshotIntervalMin Int?
  previousIdleThresholdMin      Int?
  previousIdleWarningSeconds    Int?
  nextScreenshotIntervalMin     Int?
  nextIdleThresholdMin          Int?
  nextIdleWarningSeconds        Int?
  riskLevel                     MonitoringSettingsRiskLevel
  reason                        String?
  createdAt                     DateTime                    @default(now())

  @@index([workspaceId, createdAt])
  @@index([targetUserId, createdAt])
  @@index([actorId, createdAt])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  deviceName String?
  // Rotation family: every token minted by rotating an earlier one inherits the
  // same familyId. Presenting an already-revoked token (replay/theft) revokes
  // the whole family — OAuth 2.0 BCP refresh-token reuse detection.
  familyId   String
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

/// Cached real app icons, keyed by macOS/Windows bundle id. Workspace-agnostic —
/// an app's icon is the same for everyone, so agents upload the PNG once per
/// bundle (idempotent upsert) and the insights API inlines it as a data URL.
model AppIcon {
  bundleId  String   @id
  app       String
  png       Bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Leave, company holidays and paid-leave balances
// ---------------------------------------------------------------------------

/// Which part of a working day an absence covers. FULL is a whole day; the two
/// halves are worth 0.5 each. Which half is irrelevant to the balance and load
/// bearing everywhere else — a FIRST_HALF absence on a 09:00-18:00 shift means
/// work is expected from about 13:30, so attendance reads a 1:45 PM start as on
/// time rather than four hours late. Lark's own leave form encodes the same
/// thing as AM / PM on the start and end time.
enum LeavePortion {
  FULL
  FIRST_HALF
  SECOND_HALF
}

/// PAID draws the balance down; UNPAID does not, because it costs no money.
/// "charged" and "paid" are deliberately two different columns.
enum LeaveKind {
  PAID
  UNPAID
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Where a decision came from. LARK_APPROVAL is the company's existing Lark
/// approval flow (the approval bot card people already use); DASHBOARD is an
/// admin deciding inside Timo when Lark is not wired up.
enum LeaveDecisionSource {
  LARK_APPROVAL
  DASHBOARD
  REQUESTER_CANCEL
}

enum LeaveLedgerKind {
  ACCRUAL
  CONSUMPTION
  ADJUSTMENT
}

/// Admin-owned leave settings, one row per workspace. Kept separate from
/// WorkspacePolicy (capture / privacy) and PayrollPolicy (a derived finance
/// worksheet) for the same reason those two are separate from each other:
/// different owner, different cadence of change, different blast radius.
model LeavePolicy {
  id                   String    @id @default(cuid())
  workspaceId          String    @unique
  workspace            Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Days granted per calendar month. Stored on the 0.5 grid like everything else.
  monthlyAccrualDays   Float     @default(1)
  /// Whether an unused balance survives the year end. Carry-forward is not
  /// really a feature — it is what happens when nothing resets — so turning
  /// this OFF is the case that needs code (an expiry ADJUSTMENT entry).
  carryForward         Boolean   @default(true)
  /// Ceiling on the carried balance in days. NULL = uncapped.
  carryForwardCapDays  Float?
  /// May an approved request take a balance below zero?
  allowNegativeBalance Boolean   @default(false)
  /// Accrue for the joining month itself, or start the month after.
  accrueOnJoinMonth    Boolean   @default(true)
  /// The month leave accounting begins, as YYYY-MM. NULL = from each person's
  /// joining month, which is the original behaviour.
  ///
  /// Set when a company starts keeping leave in Timo partway through the year:
  /// months before it accrue nothing, and any ledger entry effective before it
  /// is left out of the balance. The rows stay — this is a statement about what
  /// counts, not an instruction to destroy history, and somebody auditing last
  /// quarter can still see what was there.
  ledgerStartMonth     String?
  /// Extra paid-leave days granted on a person's birthday, once a year.
  /// 0 turns it off, which is the default for a workspace that has not asked
  /// for it. Granted on the day itself, and never before `ledgerStartMonth`.
  birthdayLeaveDays    Float     @default(0)
  /// Company-wide: the last Saturday of each month is not a working day. A
  /// weekly shift pattern has no way to express a monthly exception, so the
  /// rule lives here and the Working Calendar applies it.
  lastSaturdayOff      Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// A company holiday. Paid for everyone and it must never consume anybody's
/// personal balance — that is the rule that stops a Mon-Fri leave request with
/// a holiday inside it charging five days instead of four.
///
/// `teamId` NULL means the whole workspace. Postgres treats NULLs as distinct
/// in a unique index, so the unique below only protects team-scoped rows;
/// workspace-wide duplicates are rejected at the route layer instead.
model CompanyHoliday {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  /// Business calendar date in the workspace timezone — a date, not an instant.
  date        DateTime  @db.Date
  name        String
  teamId      String?
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?     @relation("HolidayCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([workspaceId, date, teamId])
  @@index([workspaceId, date])
}

/// A request to be away. Timo owns the record; the decision may come from the
/// company's Lark approval flow or from an admin in the dashboard.
model LeaveRequest {
  id               String               @id @default(cuid())
  /// Idempotency key from the client, so a retried submit does not duplicate.
  clientUuid       String               @unique
  workspaceId      String
  workspace        Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId           String
  user             User                 @relation("LeaveRequester", fields: [userId], references: [id], onDelete: Cascade)
  kind             LeaveKind            @default(PAID)
  /// Inclusive business-date range.
  startDate        DateTime             @db.Date
  endDate          DateTime             @db.Date
  /// A half-day request is always a single date; multi-day requests are FULL.
  portion          LeavePortion         @default(FULL)
  /// What this request costs the balance, priced by the Working Calendar when
  /// it was submitted, so the number the requester saw is the number charged.
  /// Re-priced at approval, because the calendar can change underneath it.
  chargedDays      Float                @default(0)
  reason           String
  status           LeaveRequestStatus   @default(PENDING)
  decisionSource   LeaveDecisionSource?
  decidedById      String?
  decidedBy        User?                @relation("LeaveDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt        DateTime?
  decidedReason    String?
  /// The Lark approval instance backing this request, when there is one.
  larkInstanceCode String?              @unique
  larkApprovalCode String?
  larkSyncedAt     DateTime?
  ledgerEntries    LeaveLedgerEntry[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([workspaceId, status])
  @@index([userId, status])
  @@index([workspaceId, startDate, endDate])
}

/// One line of the paid-leave ledger.
///
/// The balance is the sum of these, never a column we decrement. That makes a
/// retried approval a no-op (`sourceKey` is unique), makes a cancellation a
/// visible reversal rather than a silent add-back, makes carry-forward free,
/// and means a bug is fixed by recomputing rather than by guessing what a
/// counter should have been.
model LeaveLedgerEntry {
  id          String          @id @default(cuid())
  workspaceId String
  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User            @relation("LeaveLedgerSubject", fields: [userId], references: [id], onDelete: Cascade)
  kind        LeaveLedgerKind
  /// Signed days: +1 accrual, -0.5 consumption, ± adjustment. Stored as a
  /// double because every value is a multiple of 0.5, which is exactly
  /// representable in binary floating point — the 0.1 + 0.2 drift that makes
  /// people reach for integer minor-units simply does not arise for halves.
  days        Float
  /// Business date the entry counts from, so a past month stays reproducible.
  effectiveOn DateTime        @db.Date
  /// Idempotency key — `accrual:<userId>:<YYYY-MM>`, `leave:<requestId>`,
  /// `leave-reversal:<requestId>`. Unique, so writing the same fact twice
  /// loses instead of double-counting.
  sourceKey   String          @unique
  reason      String?
  requestId   String?
  request     LeaveRequest?   @relation(fields: [requestId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?           @relation("LeaveLedgerActor", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime        @default(now())

  @@index([userId, effectiveOn])
  @@index([workspaceId, effectiveOn])
  @@index([requestId])
}

/// Punch in / punch out as recorded by an EXTERNAL system (biometric reader,
/// HR export, a hand-maintained sheet) and loaded into Timo.
///
/// Deliberately NOT derived from tracked activity. Timo already knows the
/// first and last segment boundary of a day, and for a while the reports
/// showed that as "punch in / punch out" — but the two answer different
/// questions. Activity says when the laptop started working; a punch says
/// when the person was recorded at the door. They disagree often enough
/// (working from a phone, forgetting to start the tracker, badging in before
/// opening the laptop) that collapsing them hides the disagreement, which is
/// usually the interesting part.
///
/// Rows are written externally. `@@unique([userId, date])` makes a re-import
/// an upsert rather than a duplicate, so re-running a load is safe.
/// A human's correction to one day's attendance status.
///
/// The report derives a status from the Working Calendar and Timo's tracked
/// time. Both can be wrong about a real day — an agent that died mid-afternoon
/// leaves a full day reading absent. A manager or admin says what the day was,
/// and that answer wins.
///
/// Only the codes a person actually corrects live here. HOLIDAY and WEEKLY_OFF
/// come from CompanyHoliday and the shift schedule; giving them a second home
/// would let the same fact be true in two places and different in each.
model AttendanceOverride {
  id           String                 @id @default(cuid())
  workspaceId  String
  workspace    Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User                   @relation("AttendanceOverrideSubject", fields: [userId], references: [id], onDelete: Cascade)
  /// Business calendar date in the workspace timezone — a date, not an instant.
  date         DateTime               @db.Date
  code         AttendanceOverrideCode
  /// Why the day was corrected. Required: three months later this is the only
  /// question anybody asks about it.
  reason       String
  /// What the report computed at the moment this was written. If today's
  /// computed answer no longer matches, something underneath has changed —
  /// leave arriving from Lark, time syncing late — and the report flags the day
  /// rather than quietly disagreeing with the calendar.
  computedCode String?
  /// Who made the call. Nullable so deactivating a manager does not delete the
  /// corrections they made to other people's months.
  setById      String?
  setBy        User?                  @relation("AttendanceOverrideAuthor", fields: [setById], references: [id], onDelete: SetNull)
  setAt        DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@unique([userId, date])
  @@index([workspaceId, date])
}

/// The statuses a person may set by hand. Deliberately not HOLIDAY or
/// WEEKLY_OFF — those are configuration, not a judgement about one day.
enum AttendanceOverrideCode {
  P
  A
  HD
  PL
  LWP
}

model AttendancePunch {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Business calendar date in the workspace timezone — a date, not an instant.
  date        DateTime  @db.Date
  /// Clock readings local to the workspace timezone — times of day, not
  /// instants, so nothing is converted on write or on read. Seed them as they
  /// appear on the punch report: '09:15:00'. Either side may be null: a
  /// missing punch out is a real thing that happens, and is not a zero.
  punchInAt   DateTime? @db.Time
  punchOutAt  DateTime? @db.Time
  /// Free-form provenance for whoever loaded the row ("biometric export
  /// 2026-08", "manual fix — badge failed").
  note        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, date])
  @@index([workspaceId, date])
}
