{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "overlay",
  "description": "Tray popover, floating bar, prompts and the ready-to-work toast. They open the main window and dismiss the bar, nothing more.",
  "windows": ["popover", "floating", "attention", "ready-to-work"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "allow-window-open-main",
    "allow-window-dismiss-floating-bar",
    "allow-app-relaunch"
  ]
}
